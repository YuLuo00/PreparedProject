<Window x:Class="CoserRetrieval.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coser Retrieval Tasks" Width="1180" Height="860"
        MinWidth="760" MinHeight="460" Background="#171B20">
    <Window.Resources>
        <Style x:Key="StageCard" TargetType="Border">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#272D34"/>
            <Setter Property="BorderBrush" Value="#3A424C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Foreground" Value="#55C7F7"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Background Tasks" Foreground="#F2F5F7" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding NativeStatus}" Foreground="#A7B0BA" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="OrderModeBox" Width="168" SelectedIndex="0"
                          SelectionChanged="OrderMode_SelectionChanged" Margin="0,0,8,0"
                          ToolTip="Controls the active task list order">
                    <ComboBoxItem Content="Running first"/>
                    <ComboBoxItem Content="UI order priority"/>
                    <ComboBoxItem Content="Priority + follow"/>
                </ComboBox>
                <Button Content="Run Regression" Click="RunRegression_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="StartButton" Content="Start Task" Click="StartTask_Click" Padding="12,6"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#1E242B" BorderBrush="#343D47" BorderThickness="1" CornerRadius="5" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                <TextBlock Text="Command" Foreground="#AAB5BF" VerticalAlignment="Center"/>
                <ComboBox x:Name="CommandBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="ingest"/><ComboBoxItem Content="query"/></ComboBox>
                <TextBlock Grid.Column="2" Text="Input" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="InputPathBox" Grid.Column="3" Grid.ColumnSpan="2" Text="CoserRetrieval\testdata\regression"/>
                <Button Grid.Column="5" Content="Browse" Click="BrowseInput_Click" Margin="8,0,0,0"/>

                <TextBlock Grid.Row="2" Text="Database" Foreground="#AAB5BF" VerticalAlignment="Center"/>
                <TextBox x:Name="DbPathBox" Grid.Row="2" Grid.Column="1" Text="CoserRetrieval\data\ui_task.db"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Face Index" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="FaceIndexBox" Grid.Row="2" Grid.Column="3" Text="CoserRetrieval\data\ui_task_face.index"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Clothing Index" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="ClothingIndexBox" Grid.Row="2" Grid.Column="5" Text="CoserRetrieval\data\ui_task_clothing.index" Margin="8,0,0,0"/>

                <TextBlock Grid.Row="4" Text="Person / Role" Foreground="#AAB5BF" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="PersonBox" Width="130" Text="ui_task"/><TextBox x:Name="RoleBox" Width="130" Margin="8,0,0,0" ToolTip="Optional role"/></StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Models" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="ModelsPathBox" Grid.Row="4" Grid.Column="3" Text="CoserRetrieval\models"/>
                <TextBlock Grid.Row="4" Grid.Column="4" Text="Mode / TopK" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Grid.Row="4" Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0"><ComboBox x:Name="QueryModeBox" Width="88" SelectedIndex="0"><ComboBoxItem Content="all"/><ComboBoxItem Content="face"/><ComboBoxItem Content="clothing"/><ComboBoxItem Content="role"/><ComboBoxItem Content="exact"/></ComboBox><TextBox x:Name="TopKBox" Width="38" Text="5" Margin="8,0,0,0"/></StackPanel>

                <TextBlock Grid.Row="6" Text="Task ID" Foreground="#AAB5BF" VerticalAlignment="Center"/>
                <TextBox x:Name="TaskIdBox" Grid.Row="6" Grid.Column="1" Text="wpf_task"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Advanced" Foreground="#AAB5BF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="AdvancedArgsBox" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="3" ToolTip="Extra CLI arguments. Quote values that contain spaces." Margin="0,0,0,0"/>

                <TextBlock Grid.Row="8" Text="Duplicates" Foreground="#AAB5BF" VerticalAlignment="Center"/>
                <CheckBox x:Name="SkipDuplicatesBox" Grid.Row="8" Grid.Column="1" Content="Skip duplicate content" IsChecked="True"
                          ToolTip="When unchecked, the matching MD5 record and its index entries are removed before this file is ingested again." VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="4" Background="#1E242B" BorderBrush="#343D47" BorderThickness="1" Padding="6">
            <TabItem Header="{Binding ActiveTabTitle}">
            <ScrollViewer x:Name="ActiveScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl ItemsSource="{Binding Tasks}" MinWidth="1030">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="182" Margin="0,0,0,12" Padding="12" Background="#222930" BorderBrush="#39434E" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" Foreground="#DCE4EB" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="158"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#111519" BorderBrush="#3B4651" BorderThickness="1" CornerRadius="3">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Stages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StageCard}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="#AAB5BF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding Foreground}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                            <ProgressBar Style="{StaticResource StageProgress}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding FinishedTabTitle}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding FinishedTasks}" MinWidth="1030">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="182" Margin="0,0,0,12" Padding="12" Background="#222930" BorderBrush="#39434E" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" Foreground="#DCE4EB" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="158"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#111519" BorderBrush="#3B4651" BorderThickness="1" CornerRadius="3">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource StageCard}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#AAB5BF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding Foreground}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                                <ProgressBar Style="{StaticResource StageProgress}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
