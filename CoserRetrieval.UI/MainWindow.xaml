<Window x:Class="CoserRetrieval.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coser Retrieval Tasks" Width="1180" Height="760"
        MinWidth="760" MinHeight="460" Background="#171B20">
    <Window.Resources>
        <Style x:Key="StageCard" TargetType="Border">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#272D34"/>
            <Setter Property="BorderBrush" Value="#3A424C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Foreground" Value="#55C7F7"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Background Tasks" Foreground="#F2F5F7" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding NativeStatus}" Foreground="#A7B0BA" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#23313A" BorderBrush="#3E6577" BorderThickness="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="TEST MODE" Foreground="#77D7FF" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1E242B" BorderBrush="#343D47" BorderThickness="1" CornerRadius="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl ItemsSource="{Binding Tasks}" MinWidth="1030">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="182" Margin="0,0,0,12" Padding="12" Background="#222930" BorderBrush="#39434E" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" Foreground="#DCE4EB" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="158"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#111519" BorderBrush="#3B4651" BorderThickness="1" CornerRadius="3">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Stages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StageCard}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="#AAB5BF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding Foreground}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                            <ProgressBar Style="{StaticResource StageProgress}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
