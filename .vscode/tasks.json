{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Program Files\\w64devkit\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\Program Files\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build active C++ file with w64devkit g++."
        },
        {
            "type": "cmake",
            "label": "CMake: configure",
            "command": "configure",
            "preset": "gcc",
            "problemMatcher": [],
            "detail": "Configure with the gcc CMake preset."
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "UI: Build (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ArchiveToolUI/ArchiveToolUI.csproj",
                "-c",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build ArchiveToolUI (Debug)."
        },
        {
            "label": "UI: Publish to bin/",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/ArchiveToolUI/ArchiveToolUI.csproj",
                "-c",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Publish ArchiveToolUI to bin/ArchiveToolUI.exe."
        }
    ]
}
